# Deploy with secrets manager / separate .env.production. Never commit populated values.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://db-user:ROTATE@db.internal:5432/ragdb?sslmode=require
REDIS_URL=rediss://:ROTATE@redis.internal:6379/0
JWT_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS
API_KEY_PEPPER=REPLACE_WITH_ANOTHER_64_PLUS_RANDOM_CHARACTERS
ENABLE_PUBLIC_SIGNUP=false
AUTO_CREATE_TABLES=false
CORS_ORIGINS=https://rag.example.com
# Set to the *actual* trusted ingress/proxy networks; strip untrusted XFF at edge.
TRUSTED_PROXY_CIDRS=10.0.0.0/8
PUBLIC_APP_URL=https://rag.example.com
METRICS_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
STORAGE_BACKEND=s3
S3_BUCKET=private-rag-documents
S3_REGION=ap-south-1
# Leave S3_ENDPOINT_URL unset when using AWS S3 with IAM credentials.
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
OPENAI_API_KEY=REPLACE_WITH_LLM_KEY
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=openai
RETRIEVAL_MODE=hybrid
RERANKER=none
ENABLE_OCR=true
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WHSEC
STRIPE_STARTER_PRICE_ID=price_REPLACE
STRIPE_BUSINESS_PRICE_ID=price_REPLACE
SENTRY_DSN=
# Required for public signup; recommended for customer invitation emails.
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=SMTP_USER
SMTP_PASSWORD=REPLACE
SMTP_SENDER=no-reply@rag.example.com
