# Development only. Copy to .env and use `docker compose up --build`.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://rag:development_password@postgres:5432/ragdb
REDIS_URL=redis://redis:6379/0
JWT_SECRET=local-only-replace-before-deployment
API_KEY_PEPPER=local-only-replace-before-deployment
ENABLE_PUBLIC_SIGNUP=true
AUTO_CREATE_TABLES=false
CORS_ORIGINS=http://localhost:8000
PUBLIC_APP_URL=http://localhost:8000
METRICS_TOKEN=dev-only-metrics-token
STORAGE_BACKEND=s3
S3_BUCKET=rag-documents
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ragminio
S3_SECRET_ACCESS_KEY=ragminio_dev_secret
CLAMAV_ENABLED=false
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=openai
RETRIEVAL_MODE=hybrid
RERANKER=none
ENABLE_OCR=true
STRIPE_ENABLED=false
LOG_LEVEL=INFO
POSTGRES_PASSWORD=development_password
MINIO_ROOT_USER=ragminio
MINIO_ROOT_PASSWORD=ragminio_dev_secret
SMTP_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_SENDER=rag@local.test
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SENDER=RAG Platform <no-reply@example.com>
